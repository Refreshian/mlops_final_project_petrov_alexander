# Скопируйте в .env и подставьте свои значения.
# В репозиторий .env не попадает: в CI он собирается из CI/CD Variables.

# Образ сервиса из GitLab Container Registry
IMAGE=registry.gitlab.yandexcloud.net/s3504838/mlops_final_project_petrov_alexander:latest

# Хранилище данных и артефактов
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_BUCKET=r-mlops-bucket-9-1-1-65671054
S3_PREFIX=petrov_alexander_project

# Ключи доступа к S3 (в CI/CD Variables задаются как AWS_ACCESS_KEY_ID и AWS_SECRET_ACCESS_KEY)
AWS_ACCESS_KEY_ID=change_me
AWS_SECRET_ACCESS_KEY=change_me

LOG_LEVEL=INFO
# Пароль администратора Grafana (используется в docker-compose.monitoring.yml)
GRAFANA_ADMIN_PASSWORD=change_me
